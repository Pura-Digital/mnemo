# mnemo Mobile Environment Variables

# Optional hosted backend (unused in mnemo standalone builds)
EXPO_PUBLIC_API_URL=

# Optional: endpoint path for fused transcribe + cleanup in a single request
# (faster cloud dictation). Resolved against EXPO_PUBLIC_API_URL. Defaults to
# /api/transcribe when unset; the client automatically falls back to a separate
# cleanup call if this endpoint responds 404/405/501.
# EXPO_PUBLIC_TRANSCRIBE_CLEAN_ENDPOINT=/api/transcribe

# Optional: Sentry DSN. Leave empty to disable error reporting.
EXPO_PUBLIC_SENTRY_DSN=

# Optional: AppsFlyer dev key for install attribution and app-session analytics.
# AppsFlyer remains disabled when this is unset.
EXPO_PUBLIC_APPSFLYER_DEV_KEY=

# Superwall paywall SDK keys. Use separate development and production apps
# in Superwall if campaigns or products should differ by environment.
EXPO_PUBLIC_SUPERWALL_IOS_API_KEY=
EXPO_PUBLIC_SUPERWALL_ANDROID_API_KEY=

# RevenueCat observer-mode keys. RevenueCat provides an authenticated repair
# path after StoreKit purchase/restore; use the same public keys on the API.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# ArchivEye (mnemo note export)
EXPO_PUBLIC_ARCHIVEYE_CLIENT_ID=archiveye-mnemo
EXPO_PUBLIC_ARCHIVEYE_OIDC_ISSUER=http://localhost:8081/realms/archiveye-dev
EXPO_PUBLIC_ARCHIVEYE_API_BASE_URL=http://localhost:3000/api
EXPO_PUBLIC_ARCHIVEYE_WEB_URL=https://data.archiveye.ai

# Optional: Google Calendar OAuth client IDs for iOS. Development builds use
# the development value when present and otherwise fall back to the production
# value. The redirect scheme and URI are derived from the selected client ID.
EXPO_PUBLIC_GOOGLE_CALENDAR_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CALENDAR_IOS_CLIENT_ID_DEV=

# Optional: override Google Calendar redirect values when they cannot be
# derived from the OAuth client ID.
# EXPO_PUBLIC_GOOGLE_CALENDAR_IOS_REDIRECT_SCHEME=
# EXPO_PUBLIC_GOOGLE_CALENDAR_IOS_REDIRECT_SCHEME_DEV=
# EXPO_PUBLIC_GOOGLE_CALENDAR_IOS_REDIRECT_URI=
# EXPO_PUBLIC_GOOGLE_CALENDAR_IOS_REDIRECT_URI_DEV=

# Keyboard recording upload format. "auto" tries compact m4a for cloud keyboard
# dictation and persists a WAV downgrade if the backend rejects the format.
# Use "wav" for maximum compatibility or "m4a" to force compressed uploads.
EXPO_PUBLIC_KEYBOARD_AUDIO_FORMAT=auto

# Optional local development identity. Copy these to `.env.local` or export
# them in your shell when the committed identifiers are not appropriate.
# MNEMO_APP_ENV=development
# MNEMO_IOS_BUNDLE_IDENTIFIER=com.example.mnemo.dev
# MNEMO_ANDROID_PACKAGE=com.example.mnemo.dev
# MNEMO_SCHEME=mnemo-dev
# MNEMO_DISPLAY_NAME=Mnemo Dev
# MNEMO_KEYBOARD_DISPLAY_NAME=Mnemo Dev

# Compatibility-only auth override. Normally the auth client inherits
# MNEMO_SCHEME from the generated app config. Keep both values identical
# if a legacy build requires this override.
# EXPO_PUBLIC_MNEMO_SCHEME=mnemo-dev

# Advanced identity overrides. The defaults are derived from the iOS bundle ID.
# MNEMO_APP_GROUP_ID=group.com.example.mnemo.dev
# MNEMO_KEYBOARD_BUNDLE_IDENTIFIER=com.example.mnemo.dev.keyboard

# Dictionary feature is entirely local — words are stored in AsyncStorage on-device
# and never sent to any server. No environment variable needed.
