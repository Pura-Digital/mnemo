# --- Pura LLM Connect (public OAuth app, PKCE — no client secret in the app) ---
# Register the same redirect URI on https://ai.puradigital.it (integration app, public client).
# After OAuth, tokens are stored locally (Electron keychain / browser sessionStorage).
VITE_PURA_OAUTH_API_BASE=https://ai.puradigital.it/v1
VITE_PURA_CONNECT_CLIENT_ID=
# Desktop (default): mnemo-dev://pura-oauth or mnemo://pura-oauth — register the same URI on the Pura app.
# Web dev: http://localhost:5173/auth/pura/callback (loopback http allowed on Pura LLM).
# VITE_PURA_CONNECT_REDIRECT_URI=mnemo-dev://pura-oauth
# VITE_MNEMO_OAUTH_PROTOCOL=mnemo-dev
# Legacy names (still supported):
# VITE_PURA_CLIENT_ID=
# VITE_PURA_API_BASE=https://ai.puradigital.it/v1
# VITE_PURA_REDIRECT_URI=https://mnemo.com/auth/pura-callback

# Better Auth (optional - for account features)
# Self-hosted auth server URL (defaults to https://auth.mnemo.com)
VITE_AUTH_URL=

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Customize the Whisper model
# Available models: whisper-1 (default), whisper-1-large, whisper-1-large-v2
WHISPER_MODEL=whisper-1

# Optional: Set language for better transcription accuracy
# Leave empty for auto-detection, or use language codes like 'en', 'es', 'fr', etc.
LANGUAGE=

# Optional: UI language for app interface and menus (en, es, fr, de, pt, it)
UI_LANGUAGE=en

# Anthropic API Configuration (optional - for Claude AI processing)
# Get your API key from: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Configuration (optional - for Gemini AI processing)
# Get your API key from: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Configuration (optional - for ultra-fast cloud inference)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tinfoil API Configuration (optional - for private cloud LLM inference)
# Get your API key from: https://tinfoil.sh/inference
TINFOIL_API_KEY=your_tinfoil_api_key_here

# Mistral API Configuration (optional - for Voxtral transcription)
# Get your API key from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here

# ArchivEye (mnemo note export / knowledge base)
ARCHIVEYE_CLIENT_ID=archiveye-mnemo
ARCHIVEYE_OIDC_ISSUER=http://localhost:8081/realms/archiveye-dev
ARCHIVEYE_TOKEN_URL=
ARCHIVEYE_API_BASE_URL=http://localhost:3000/api
ARCHIVEYE_WEB_URL=https://data.archiveye.ai
VITE_ARCHIVEYE_CLIENT_ID=

# Optional: Debug mode
MNEMO_LOG_LEVEL=debug
